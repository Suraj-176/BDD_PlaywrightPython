{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run All Tests (Pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "--alluredir=reports/allure-results"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run Sanity Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "-m", "Sanity",
        "--alluredir=reports/allure-results"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run Regression Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "-m", "Regression",
        "--alluredir=reports/allure-results"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
