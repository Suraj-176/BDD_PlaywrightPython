# ========== SELF-HEALING AI CONFIGURATION ==========
AI_PROVIDER=GEMINI

# --- GEMINI ---
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-pro

# --- GROQ ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OPENAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- CLAUDE ---
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- AZURE OPENAI ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_MODEL=your_azure_openai_model_or_deployment_name_here
AZURE_OPENAI_API_URL=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_VERSION=2023-05-15

# ========== APPLICATION CONFIGURATION ==========
BASE_URL=https://www.saucedemo.com/
TEST_ENV=SIT

# ========== TIMEOUTS (milliseconds) ==========
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=90000
ACTION_TIMEOUT=10000
MAX_RETRIES=1

# ========== EXECUTION SETTINGS ==========
HEADLESS=true
WORKERS=1

# ========== LOGGING CONFIGURATION ==========
LOG_LEVEL=INFO
DEBUG_MODE=false
LOG_FILE_PATH=logs/automation.log

# ========== DATABASE CONFIGURATION ==========
DB_HOST=localhost
DB_PORT=5432
DB_USER=automation_user
DB_PASSWORD=secure_password_here
DB_NAME=aml_application_db
DB_SSL=true

# ========== API CONFIGURATION ==========
API_BASE_URL=https://api.icici.com
API_TIMEOUT=30000
API_RETRIES=1

# ========== AML-SPECIFIC CONFIGURATIONS ==========
SANCTIONS_CHECK_API=https://sanctions-api.icici.com
KYC_API=https://kyc-api.icici.com
SAR_FILING_API=https://sar-filing-api.icici.com
AUDIT_LOG_TABLE=audit_logs
PEP_CHECK_ENABLED=true
TRANSACTION_THRESHOLD=1000000

# ========== REPORTING CONFIGURATION ==========
ALLURE_RESULTS_DIR=reports/allure-results
ALLURE_REPORT_DIR=reports/allure-report
SCREENSHOTS_DIR=reports/screenshots
VIDEOS_DIR=reports/videos

# ========== SECURITY CONFIGURATION ==========
ENCRYPTION_ENABLED=true
TLS_VERSION=1.3
SECURE_COOKIES_REQUIRED=true
SENSITIVE_DATA_MASKING=true

# ========== CI/CD CONFIGURATION ==========
CI=false
AUTO_OPEN_REPORT=true
BUILD_NUMBER=
GIT_COMMIT=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ENABLE_AI_HEALING=false
